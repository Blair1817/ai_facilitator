# LLM Parameters
# Copy this file to `.env` and fill in your real values. `.env` is
# git-ignored (see root .gitignore `*.env` rule) so real keys are never
# committed. Do NOT put real keys in this file -- it is the public
# template.

# The production LLM endpoint. Use the exact URL the platform's
# operations team gave you; do not infer it from the variable name alone.
# Phase 6.3 frozen: confirmed https://api.minimax.chat/v1 (Q9).
# Append "/chat/completions" is added in code (callbacks.js) so the
# `.env` value stays free of the API-style suffix.
LLM_API_ENDPOINT="https://api.minimax.chat/v1"

# The actual API key. Place the real value in `server/.env`, NOT here.
# This placeholder is a non-functional string; loading the experiment
# without a real key will fail loudly at startup (Phase 2.5 self-check
# plus Phase 6's OPENAI_API_KEY fail-fast in onGameStart).
OPENAI_API_KEY="your-key-here"

# Phase 6.3 (frozen model version): no alias. Pinned to the
# platform-confirmed model id for the live LLM endpoint
# (api.minimax.chat). Verified during pilot prep on 2026-08-11:
#   - "gpt-4o" / "gpt-4o-2024-08-06" / "abab-6.5s" all return 400
#     "unknown model"
#   - "MiniMax-Text-01" works, returns clean JSON when prompted
#   - MiniMax M2 reasoning models require `reasoning_split` plus a sufficient
#     `max_completion_tokens` budget. callbacks.js applies that policy through
#     LLMTransport.mjs when an M2 model is configured; strict schema and
#     semantic validation still run on the final content.
# Whatever string ends up here is recorded in game-level
# systemInfo.model and in every llmLog entry, so post-hoc analysis
# can recover exactly which snapshot produced each intervention.
OPENAI_MODEL="MiniMax-Text-01"

# For M2 models this value is automatically raised to a 4096-token completion
# floor because reasoning consumes completion tokens before the final JSON.
LLM_MAX_OUTPUT_TOKENS=1000
