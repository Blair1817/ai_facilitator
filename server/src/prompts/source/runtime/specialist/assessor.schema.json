{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Categorical Need Detector Output Schema (2026-10-21)",
  "description": "One of four discussion needs with exact per-message evidence. Need/operation consistency, quotation accuracy, author counts and participation are re-verified deterministically by EvidenceChecker.checkNeedAssessment().",
  "type": "object",
  "properties": {
    "need": { "type": "string", "enum": ["ELICIT", "SCRUTINIZE", "INTEGRATE", "NONE"] },
    "operation": {
      "type": ["string", "null"],
      "enum": [null, "coverage_gap", "vague_information", "participation_gap", "unsupported_claim", "unclear_assumption", "unresolved_concern", "unclear_link", "fragmented_evidence", "cross_option_evidence", "public_discrepancy"]
    },
    "target": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "properties": {
            "label": { "type": "string", "minLength": 1, "maxLength": 300 },
            "messageIds": { "type": "array", "items": { "type": "string" }, "minItems": 1, "uniqueItems": true },
            "evidence": { "type": "array", "items": { "$ref": "#/definitions/evidenceQuote" }, "minItems": 1 },
            "optionLabels": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
            "criteria": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
            "participantName": { "type": "string", "minLength": 1, "description": "Mandatory only when operation is participation_gap; must exactly match a code-supplied quiet participant." }
          },
          "required": ["label", "messageIds", "evidence", "optionLabels", "criteria"],
          "additionalProperties": false
        }
      ]
    },
    "rationale": { "type": "string", "maxLength": 300 }
  },
  "required": ["need", "operation", "target", "rationale"],
  "additionalProperties": false,
  "definitions": {
    "evidenceQuote": {
      "type": "object",
      "properties": {
        "messageId": { "type": "string", "minLength": 1 },
        "span": { "type": "string", "minLength": 1 }
      },
      "required": ["messageId", "span"],
      "additionalProperties": false
    }
  }
}
