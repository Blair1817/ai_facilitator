{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Need Detector Output Schema (independent judgements, 2026-10-26)",
  "description": "Three independently judged candidate needs (elicit, scrutinize, integrate), each null or one operation with exact per-message evidence. No ranking between needs. Quotation accuracy and author counts are re-verified per candidate by EvidenceChecker.checkNeedAssessment(); the runtime selects among verified candidates.",
  "type": "object",
  "properties": {
    "candidates": {
      "type": "object",
      "properties": {
        "elicit": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "operation": {
                  "enum": [
                    "coverage_gap",
                    "vague_information"
                  ]
                },
                "target": {
                  "$ref": "#/definitions/target"
                },
                "rationale": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                },
                "semanticReview": {
                  "$ref": "#/definitions/semanticReview"
                }
              },
              "required": [
                "operation",
                "target",
                "rationale"
              ],
              "additionalProperties": false
            }
          ]
        },
        "scrutinize": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "operation": {
                  "enum": [
                    "unsupported_claim",
                    "unclear_assumption",
                    "unresolved_concern",
                    "unclear_link"
                  ]
                },
                "target": {
                  "$ref": "#/definitions/target"
                },
                "rationale": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                },
                "semanticReview": {
                  "$ref": "#/definitions/semanticReview"
                }
              },
              "required": [
                "operation",
                "target",
                "rationale"
              ],
              "additionalProperties": false
            }
          ]
        },
        "integrate": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "operation": {
                  "enum": [
                    "fragmented_evidence",
                    "cross_option_evidence",
                    "public_discrepancy"
                  ]
                },
                "target": {
                  "$ref": "#/definitions/target"
                },
                "rationale": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                },
                "semanticReview": {
                  "$ref": "#/definitions/semanticReview"
                }
              },
              "required": [
                "operation",
                "target",
                "rationale"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "elicit",
        "scrutinize",
        "integrate"
      ],
      "additionalProperties": false
    },
    "rationale": {
      "type": "string",
      "maxLength": 300
    },
    "defer": {
      "description": "Optional deliberate pause while a participant explicitly summarises now. Allowed only when all three candidates are null. Omit otherwise.",
      "type": "object",
      "properties": {
        "reason": {
          "const": "participant_summary_in_progress"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/evidenceQuote"
          },
          "minItems": 1
        }
      },
      "required": [
        "reason",
        "evidence"
      ],
      "additionalProperties": false
    },
    "closeout": {
      "type": "object",
      "properties": {
        "proposal": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "active": {
                  "type": "boolean"
                },
                "optionLabel": {
                  "type": "string"
                },
                "evidence": {
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/evidenceQuote"
                  }
                }
              },
              "required": [
                "active",
                "optionLabel",
                "evidence"
              ],
              "additionalProperties": false
            }
          ]
        },
        "participants": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "participantName": {
                "type": "string"
              },
              "reviewedThroughMessageId": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "stance": {
                "enum": [
                  "ready",
                  "preference",
                  "uncommitted",
                  "withdrawn",
                  "object",
                  "continue"
                ]
              },
              "optionLabel": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "evidence": {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/evidenceQuote"
                }
              }
            },
            "required": [
              "participantName",
              "reviewedThroughMessageId",
              "stance",
              "optionLabel",
              "evidence"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "proposal",
        "participants"
      ],
      "additionalProperties": false
    },
    "integrationStatus": {
      "enum": [
        "qualified",
        "insufficient_material",
        "already_covered",
        "participant_summary_in_progress",
        "no_open_integration",
        "not_assessed"
      ]
    }
  },
  "required": [
    "candidates",
    "rationale"
  ],
  "additionalProperties": false,
  "definitions": {
    "evidenceQuote": {
      "type": "object",
      "properties": {
        "messageId": {
          "type": "string",
          "minLength": 1
        },
        "span": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "messageId",
        "span"
      ],
      "additionalProperties": false
    },
    "target": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "messageIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/evidenceQuote"
          },
          "minItems": 1
        },
        "optionLabels": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "criteria": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "label",
        "messageIds",
        "evidence",
        "optionLabels",
        "criteria"
      ],
      "additionalProperties": false
    },
    "semanticReview": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1
        },
        "matches": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "relation": {
                "enum": [
                  "different",
                  "unchanged",
                  "material_change"
                ]
              },
              "responseEvidence": {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/evidenceQuote"
                }
              },
              "newEvidence": {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/evidenceQuote"
                }
              }
            },
            "required": [
              "id",
              "relation",
              "responseEvidence",
              "newEvidence"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "key",
        "matches"
      ],
      "additionalProperties": false
    }
  }
}
