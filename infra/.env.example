# Copy to infra/.env on the NAS and chmod 600. Never commit or share the real
# file. docker compose fails if a required value is absent.

# NAS identity and fixed LAN address. Obtain UID/GID with: id <nas-user>
DELIBRA_UID=10001
DELIBRA_GID=10001
NAS_BIND_IP=192.168.1.50
DELIBRA_IMAGE_TAG=9c6a777
DELIBRA_ENV_FILE=.env

# Host paths. INTERNAL and EXTERNAL must be different physical storage.
DELIBRA_DATA_DIR=/volume1/delibra/data
DELIBRA_INTERNAL_BACKUP_DIR=/volume1/delibra/backups
DELIBRA_EXTERNAL_BACKUP_DIR=/volume2/delibra-backups
DELIBRA_CONFIG_FILE=/volume1/delibra/secrets/empirica.toml
DELIBRA_BACKUP_KEY_FILE=/volume1/delibra/secrets/backup-passphrase
BACKUP_RETENTION_DAYS=90

# D-014: research-data export server (D-014). The server binds to the
# loopback interface only; cloudflared forwards the public `exports.*`
# route to it. To disable (e.g. during incident response) set
# DELIBRA_DISABLE_EXPORT_SERVER=1 in the env passed to docker compose.
EXPORT_PORT=3001
EXPORT_AUDIT_FILE=/data/export-audit.jsonl
# DELIBRA_DISABLE_EXPORT_SERVER=0

# Frozen live-model configuration. The model is part of the experimental
# treatment and must not be changed without a recorded decision and rerun.
LLM_API_ENDPOINT=https://api.minimax.chat/v1
OPENAI_API_KEY=__REGENERATE_OPENAI_API_KEY__
OPENAI_MODEL=MiniMax-Text-01
LLM_MAX_OUTPUT_TOKENS=1000

# Server-only research mirror. Never place the service-role key in client code.
SUPABASE_URL=__REGENERATE_SUPABASE_URL__
SUPABASE_SERVICE_ROLE_KEY=__REGENERATE_SUPABASE_SERVICE_ROLE_KEY__
