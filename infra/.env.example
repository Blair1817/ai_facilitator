# Infrastructure env file template
#
# Copy to `.env` and replace every `__REGENERATE__` value before
# `docker compose --env-file .env up -d`. The `__REGENERATE__` strings are
# intentionally invalid; docker-compose's `${VAR:?error message}` syntax
# in docker-compose.yml will fail fast if any of them are left in place.
#
# Source-of-truth for each variable:
#   - LLM_*         server/src/LLMConfig.js
#   - TAJRIBA_*     .empirica/empirica.toml + .empirica/empirica.toml.example
#   - SUPABASE_*    server/src/SupabasePersistence.js + server/src/callbacks.js
#   - B2_*          infra/scripts/backup-tajriba-b2.sh
#   - CLOUDFLARE_*  infra/cloudflared/config.yml
#   - VITE_*        client/src/intro-exit/UserInterface.jsx + client/.env.example
#
# Do not commit the real `.env`. This template is the only thing that
# should be in git for env layout.

# ── LLM (server) ───────────────────────────────────────────────────────────────
# The platform endpoint the LLM transport targets. Do not append
# `/chat/completions`; the transport layer adds it.
LLM_API_ENDPOINT="https://api.minimax.chat/v1"

# The actual MiniMax platform API key. Source the value from the same place
# the existing local `server/.env` does; do not paste it in chat.
OPENAI_API_KEY="__REGENERATE_OPENAI_API_KEY__"

# Frozen model per current-status.md: do not change without a new D-XXX decision.
OPENAI_MODEL="MiniMax-Text-01"

# Output token cap. The live provider's reasoning models need a higher floor
# (see LLMTransport.mjs); 1000 is a safe default for the non-reasoning path.
LLM_MAX_OUTPUT_TOKENS="1000"

# ── Tajriba (tajriba container) ────────────────────────────────────────────────
# Admin session token. Generate with `openssl rand -hex 32` (64 hex chars).
TAJRIBA_SRTOKEN="__REGENERATE_TAJRIBA_SRTOKEN__"

# Admin username. Default is "admin"; consider a non-default name in
# production to reduce scanning-noise.
TAJRIBA_ADMIN_USERNAME="admin"

# Admin password. Generate with `openssl rand -hex 32`.
TAJRIBA_ADMIN_PASSWORD="__REGENERATE_TAJRIBA_ADMIN_PASSWORD__"

# ── Supabase (callbacks container) ─────────────────────────────────────────────
# Project URL. Format: https://<project-ref>.supabase.co
SUPABASE_URL="__REGENERATE_SUPABASE_URL__"

# Service-role key (NOT the anon key). The service-role key bypasses RLS;
# it is required because the callbacks service writes on behalf of every
# participant. Treat it like the LLM API key.
SUPABASE_SERVICE_ROLE_KEY="__REGENERATE_SUPABASE_SERVICE_ROLE_KEY__"

# ── Backblaze B2 (backup script) ───────────────────────────────────────────────
# Application key ID. From B2 → App Keys → Add a New Application Key.
# Restrict the key to a single bucket (Capacity: List + Read/Write).
B2_APPLICATION_KEY_ID="__REGENERATE_B2_APPLICATION_KEY_ID__"

# Application key. Same place as the key ID.
B2_APPLICATION_KEY="__REGENERATE_B2_APPLICATION_KEY__"

# Bucket name. Convention: delibra-<short-hash-from-uuidgen>.
B2_BUCKET_NAME="__REGENERATE_B2_BUCKET_NAME__"

# ── Cloudflare Tunnel (cloudflared container) ──────────────────────────────────
# The tunnel token from the Cloudflare Zero Trust dashboard:
#   https://one.dash.cloudflare.com → Networks → Tunnels → <tunnel> → Configure
#   → Install/run a connector → Docker → copy the token (starts with "ey...")
CLOUDFLARE_TUNNEL_TOKEN="__REGENERATE_CLOUDFLARE_TUNNEL_TOKEN__"

# ── Client (client container) ──────────────────────────────────────────────────
# "prolific" enables the Prolific-recruited flow (auto ID from URL params);
# "local" enables the manual PlayerCreate form used in pilot and rehearsal.
VITE_RECRUITMENT_MODE="local"

# Public-facing URL the client uses for callbacks / API calls. After the
# Cloudflare Tunnel is up, this should be https://api.<your-domain>.
VITE_API_BASE_URL="http://localhost:8080"
