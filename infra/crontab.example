# Encrypted Tajriba backup every four hours. Install only after a manual backup
# and restore drill have both passed. This invokes the script inside the
# running, version-pinned Delibra container.

SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

17 */4 * * * root cd /volume1/delibra/infra && /usr/local/bin/docker compose --env-file .env exec -T empirica /opt/delibra/backup-local-encrypted.sh >> /volume1/delibra/logs/backup.log 2>&1
