# Copy to infra/.env on the build host (Mac) when targeting Azure. Never
# commit the real file (.env is gitignored). This file documents the
# Azure-specific variables; the NAS-specific DELIBRA_DATA_DIR /
# NAS_BIND_IP / backup-key paths in .env.example do not apply on Azure
# (the data dir is a Container App volume mount, not a host bind).
#
# Build flow (see README "Azure deployment" for the full procedure):
#   1. Populate infra/prewarm/ from a running v1.12.5 container
#      (the image needs the Tajriba binary offline to avoid a
#      github.com fetch on first start). The current working image
#      lives on the NAS at 192.168.0.109:922 — see
#      infra/scripts/capture-prewarm-from-running.sh.
#   2. docker build --pull -t delibra-nas:"$DELIBRA_IMAGE_TAG" \
#        -f infra/Dockerfile .
#   3. docker push "$ACR_LOGIN_SERVER/delibra-nas:$DELIBRA_IMAGE_TAG"

# UID/GID inside the container. Keep 10001 to match the NAS image so
# volumes that come from existing snapshots preserve ownership.
DELIBRA_UID=10001
DELIBRA_GID=10001

# Image tag. Use a build-specific label that ties to git + date + target
# so the same source produces a unique, traceable image.
#   example: 007ff5a-v1.12.5-azure-20260829
# See infra/scripts/build-for-azure.sh for the helper that derives this
# from `git rev-parse --short HEAD` + `date +%Y%m%d`.
DELIBRA_IMAGE_TAG=007ff5a-v1.12.5-azure-20260829

# Azure Container Registry. The login server is globally unique; the
# registry is created in the Azure portal (see azure-deployment-guide.md
# in the project root). Admin user must be ENABLED in the portal for
# `docker login` to work (or use `az acr login` with an Azure CLI
# session — preferred for shared/team environments).
ACR_LOGIN_SERVER=acrdelibra.azurecr.io
ACR_NAME=acrdelibra
# ACR username/password are NOT stored here. They are read from
# `az acr credential show --name $ACR_NAME` or the portal's
# Access keys page and passed to `docker login` at push time.
