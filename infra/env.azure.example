# Optional non-secret local build settings for Azure image builds.
# Export these in the invoking shell only when overriding the container UID/GID.
# The Azure build helper deliberately does not source an environment file.

DELIBRA_UID=10001
DELIBRA_GID=10001

# Fixed production image destination (documented here for operator review):
#   registry:   acrdelibra-hhckbjfbe3ctata7.azurecr.io
#   repository: delibra-nas
#
# infra/scripts/build-for-azure.sh computes the immutable tag itself:
#   <7-char-git-sha>-v1.12.5-azure-<UTC-YYYYMMDD>
# It does not accept a custom tag and never publishes `latest`.

# Runtime configuration is supplied to Azure Container Apps, not this build
# file. Keep OPENAI_API_KEY, OPENAI_MODEL, LLM_API_ENDPOINT,
# LLM_MAX_OUTPUT_TOKENS, SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, and the
# external /run/secrets/empirica.toml outside the image.

# GitHub Actions release authentication uses Azure OIDC. Configure the
# repository variables AZURE_CLIENT_ID, AZURE_TENANT_ID, and
# AZURE_SUBSCRIPTION_ID externally; do not add credential values here.
