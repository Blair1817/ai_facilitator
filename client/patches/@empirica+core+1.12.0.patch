+    // DELIBRA-PATCH: listen for the "closed" event emitted by the patched
+    // @empirica/tajriba `stop()` (index.js). The upstream wrapper only watches
+    // connected/disconnected/error, so when stop() fires (e.g. on Access
+    // Denied) the wrapper was not re-entering the connecting state and the
+    // participant UI stayed on the loading page forever. With this listener
+    // we re-arm the connection attempt.
+    this.tajriba.on("closed", () => {
+      if (this._stopped.getValue()) {
+        return;
+      }
+      if (this._connected.getValue()) {
+        this._connected.next(false);
+      }
+      if (!this._connecting.getValue()) {
+        this._connecting.next(true);
+      }
+      // Re-connect after a short delay (graphql-ws retry loop already
+      // handles backoff; this is only needed because stop() disposed the
+      // underlying WS client).
+      try {
+        this.tajriba.connect && this.tajriba.connect();
+      } catch (e) {
+        // ignore - already connecting
+      }
+    });
     this.tajriba.on("error", (err) => {
       error("connection error", err);
     });
