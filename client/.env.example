# Recruitment mode
# "prolific" enables the formal Prolific-recruited flow: participants are
# auto-identified from PROLIFIC_PID/STUDY_ID/SESSION_ID URL params (no manual
# PlayerCreate form), and Debriefing redirects to VITE_PROLIFIC_COMPLETION_URL.
# Any other value (or leaving this unset) uses local/dev mode: the existing
# manual PlayerCreate identifier form, and ?participantKey=p1/p2/p3 testing.
VITE_RECRUITMENT_MODE=local

# Prolific study completion redirect URL. Required for real Prolific
# deployments (recruitment mode "prolific"). If left unset, the Debriefing
# step shows a dev-only warning and falls back to the placeholder
# FinishedExitCode screen instead of redirecting to an invalid address.
VITE_PROLIFIC_COMPLETION_URL=
