# Recruitment mode
# "prolific" enables the formal Prolific-recruited flow: participants are
# auto-identified from PROLIFIC_PID/STUDY_ID/SESSION_ID URL params (no manual
# PlayerCreate form).
# Any other value (or leaving this unset) uses local/dev mode: the existing
# manual PlayerCreate identifier form, and ?participantKey=p1/p2/p3 testing.
VITE_RECRUITMENT_MODE=local
